<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Character Calculator</title>
	<style>
		@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');

		:root {
			--ink: #15211f;
			--muted: #687572;
			--paper: #f5f1e8;
			--panel: #fffdf8;
			--accent: #e36d45;
			--accent-soft: #f7d7c8;
			--button: #e9eee9;
			--shadow: 0 24px 65px rgba(39, 54, 48, .13);
		}

		* { box-sizing: border-box; }
		body {
			margin: 0;
			min-height: 100vh;
			color: var(--ink);
			background: var(--paper);
			font-family: 'Space Grotesk', sans-serif;
			background-image: radial-gradient(circle at 10% 10%, rgba(227,109,69,.16), transparent 25%), radial-gradient(circle at 90% 88%, rgba(73,132,119,.16), transparent 28%);
		}

		main { width: min(1080px, 92vw); margin: auto; padding: 48px 0; }
		header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
		.eyebrow { color: var(--accent); font: 500 12px 'DM Mono', monospace; letter-spacing: .14em; text-transform: uppercase; }
		h1 { margin: 8px 0 0; font-size: clamp(2.4rem, 6vw, 5rem); line-height: .92; letter-spacing: -.07em; }
		.subtitle { max-width: 285px; margin: 0; color: var(--muted); line-height: 1.5; }
		.workspace { display: grid; grid-template-columns: minmax(230px, .78fr) minmax(320px, 1.22fr); gap: 22px; align-items: start; }
		.panel { background: rgba(255,253,248,.78); border: 1px solid rgba(21,33,31,.09); border-radius: 22px; box-shadow: var(--shadow); backdrop-filter: blur(12px); }
		.characters { padding: 22px; }
		.section-label { margin: 0 0 15px; font: 500 12px 'DM Mono', monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
		.character { width: 100%; display: flex; align-items: center; gap: 13px; padding: 13px; border: 1px solid transparent; border-radius: 14px; background: transparent; color: var(--ink); text-align: left; cursor: pointer; font: inherit; transition: .2s ease; }
		.character:hover, .character.active { background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 35%, transparent); transform: translateX(3px); }
		.avatar { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--ink); color: var(--paper); font-size: 20px; }
		.character strong, .character span { display: block; }
		.character strong { font-size: 15px; }
		.character span { margin-top: 3px; color: var(--muted); font-size: 12px; }
		.tip { margin: 30px 0 2px; padding: 16px; border-left: 3px solid var(--accent); color: var(--muted); font-size: 13px; line-height: 1.5; }

		.calculator { padding: 22px; background: var(--panel); }
		.display { min-height: 150px; padding: 22px 18px; display: flex; flex-direction: column; justify-content: end; overflow: hidden; border-radius: 16px; background: var(--ink); color: var(--paper); }
		.display-note { color: color-mix(in srgb, var(--paper) 58%, transparent); font: 12px 'DM Mono', monospace; }
		.display-value { margin-top: 8px; overflow: auto; text-align: right; white-space: nowrap; font: 500 clamp(2.2rem, 7vw, 4.2rem) 'DM Mono', monospace; letter-spacing: -.08em; }
		.keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 16px; }
		button.key { min-height: 60px; border: 0; border-radius: 13px; background: var(--button); color: var(--ink); cursor: pointer; font: 500 1.1rem 'DM Mono', monospace; transition: transform .12s ease, background .12s ease; }
		button.key:hover { background: var(--accent-soft); }
		button.key:active { transform: scale(.95); }
		button.key.operator { background: var(--accent-soft); color: var(--accent); }
		button.key.equals { grid-row: span 2; background: var(--accent); color: white; }
		button.key.clear { color: var(--accent); }
		.history { margin-top: 19px; padding-top: 17px; border-top: 1px solid rgba(21,33,31,.1); }
		.history-list { display: flex; gap: 8px; overflow-x: auto; min-height: 22px; }
		.history-list span { flex: 0 0 auto; color: var(--muted); font: 12px 'DM Mono', monospace; }

		@media (max-width: 700px) {
			main { padding: 28px 0; }
			header { display: block; }
			.subtitle { margin-top: 17px; }
			.workspace { grid-template-columns: 1fr; }
			.characters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; padding: 13px; }
			.section-label, .tip { grid-column: 1 / -1; }
			.character { display: block; padding: 9px; text-align: center; }
			.avatar { margin: 0 auto 7px; }
			.character:hover, .character.active { transform: translateY(-2px); }
			button.key { min-height: 55px; }
		}
	</style>
</head>
<body>
	<main>
		<header>
			<div><div class="eyebrow">A calculator for every mood</div><h1 id="title">Count it<br>your way.</h1></div>
			<p class="subtitle" id="subtitle">Choose a character to make the calculator feel like yours.</p>
		</header>
		<div class="workspace">
			<section class="panel characters" aria-label="Choose a character">
				<p class="section-label">Choose character</p>
				<button class="character active" data-character="sage"><span class="avatar">◒</span><strong>Sage</strong><span>calm & clear</span></button>
				<button class="character" data-character="spark"><span class="avatar">✦</span><strong>Spark</strong><span>bright & quick</span></button>
				<button class="character" data-character="orbit"><span class="avatar">◉</span><strong>Orbit</strong><span>focused & cool</span></button>
				<p class="tip">Use your keyboard too: numbers, <b>+</b> <b>−</b> <b>×</b> <b>÷</b>, Enter, and Escape all work.</p>
			</section>
			<section class="panel calculator" aria-label="Calculator">
				<div class="display"><div class="display-note" id="displayNote">Sage is ready</div><div class="display-value" id="display" aria-live="polite">0</div></div>
				<div class="keys">
					<button class="key clear" data-action="clear">AC</button><button class="key" data-action="sign">+/−</button><button class="key" data-action="percent">%</button><button class="key operator" data-value="/">÷</button>
					<button class="key" data-value="7">7</button><button class="key" data-value="8">8</button><button class="key" data-value="9">9</button><button class="key operator" data-value="*">×</button>
					<button class="key" data-value="4">4</button><button class="key" data-value="5">5</button><button class="key" data-value="6">6</button><button class="key operator" data-value="-">−</button>
					<button class="key" data-value="1">1</button><button class="key" data-value="2">2</button><button class="key" data-value="3">3</button><button class="key operator" data-value="+">+</button>
					<button class="key" data-value="0">0</button><button class="key" data-value=".">.</button><button class="key equals" data-action="equals">=</button>
				</div>
				<div class="history"><p class="section-label">Recent sums</p><div class="history-list" id="history"><span>No calculations yet</span></div></div>
			</section>
		</div>
	</main>
	<script>
		const display = document.querySelector('#display');
		const displayNote = document.querySelector('#displayNote');
		const history = document.querySelector('#history');
		let expression = '';
		let justCalculated = false;
		let activeCharacter = 'Sage';
		const characters = {
			sage: { name: 'Sage', note: 'Sage is ready', accent: '#e36d45', soft: '#f7d7c8', ink: '#15211f', greeting: 'Choose a character to make the calculator feel like yours.' },
			spark: { name: 'Spark', note: 'Spark is switched on', accent: '#d94f72', soft: '#f7ced9', ink: '#241b2a', greeting: 'Fast answers, bright energy, zero fuss.' },
			orbit: { name: 'Orbit', note: 'Orbit is in focus', accent: '#357b86', soft: '#cbe5e4', ink: '#14272c', greeting: 'A quiet space for precise little answers.' }
		};

		function render() { display.textContent = expression || '0'; }
		function addHistory(value) {
			if (history.textContent.includes('No calculations')) history.innerHTML = '';
			const item = document.createElement('span'); item.textContent = value; history.prepend(item);
			while (history.children.length > 4) history.lastElementChild.remove();
		}
		function calculate() {
			if (!expression || !/[+*/-]/.test(expression)) return;
			try {
				const result = Function('"use strict"; return (' + expression + ')')();
				if (!Number.isFinite(result)) throw new Error();
				addHistory(expression.replaceAll('*', '×').replaceAll('/', '÷') + ' = ' + result);
				expression = String(Number(result.toFixed(10))); justCalculated = true; render(); displayNote.textContent = activeCharacter + ' solved it';
			} catch { expression = ''; display.textContent = 'Error'; displayNote.textContent = 'Try a simpler sum'; }
		}
		function input(value) {
			if (justCalculated && /[0-9.]/.test(value)) expression = '';
			justCalculated = false;
			if (value === '.' && expression.split(/[+*/-]/).pop().includes('.')) return;
			if (/[+*/-]/.test(value) && /[+*/-]$/.test(expression)) expression = expression.slice(0, -1);
			expression += value; render();
		}
		document.querySelectorAll('[data-value]').forEach(button => button.addEventListener('click', () => input(button.dataset.value)));
		document.querySelector('[data-action="clear"]').addEventListener('click', () => { expression = ''; justCalculated = false; displayNote.textContent = characters[activeCharacter.toLowerCase()].note; render(); });
		document.querySelector('[data-action="equals"]').addEventListener('click', calculate);
		document.querySelector('[data-action="sign"]').addEventListener('click', () => { if (expression) expression = expression.startsWith('-') ? expression.slice(1) : '-' + expression; render(); });
		document.querySelector('[data-action="percent"]').addEventListener('click', () => { if (expression) expression = String(Number(expression) / 100); render(); });
		document.querySelectorAll('.character').forEach(button => button.addEventListener('click', () => {
			document.querySelector('.character.active').classList.remove('active'); button.classList.add('active');
			const theme = characters[button.dataset.character]; activeCharacter = theme.name;
			document.documentElement.style.setProperty('--accent', theme.accent); document.documentElement.style.setProperty('--accent-soft', theme.soft); document.documentElement.style.setProperty('--ink', theme.ink);
			document.querySelector('#subtitle').textContent = theme.greeting; displayNote.textContent = theme.note;
		}));
		document.addEventListener('keydown', event => {
			if (/^[0-9.]$/.test(event.key)) input(event.key);
			else if ('+-*/'.includes(event.key)) input(event.key);
			else if (event.key === 'Enter' || event.key === '=') calculate();
			else if (event.key === 'Escape') document.querySelector('[data-action="clear"]').click();
			else if (event.key === 'Backspace') { expression = expression.slice(0, -1); render(); }
		});
	</script>
</body>
</html>